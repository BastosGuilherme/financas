rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid));
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);
      allow write: if false;
    }

    match /households/{householdId}/members/{userId} {
      allow read: if isMember(householdId);
      // Membership is provisioned manually by the administrator.
      allow write: if false;
    }

    match /households/{householdId}/accounts/{accountId} {
      allow read, write: if isMember(householdId);
    }

    match /households/{householdId}/transactions/{transactionId} {
      allow read, write: if isMember(householdId);
    }

    match /households/{householdId}/budgets/{budgetId} {
      allow read, write: if isMember(householdId);
    }

    match /households/{householdId}/categories/{categoryId} {
      allow read, write: if isMember(householdId);
    }

    match /households/{householdId}/investmentSnapshots/{snapshotId} {
      allow read, write: if isMember(householdId);
    }

    match /households/{householdId}/shoppingItems/{itemId} {
      allow read, write: if isMember(householdId);
    }

    match /households/{householdId}/appointments/{appointmentId} {
      allow read, write: if isMember(householdId);
    }
  }
}
